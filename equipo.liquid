
<div class="equipo-wrapper">
  <div class="equipo__imagen">
    {%- if section.settings.imagen != blank -%}
      {{
        section.settings.imagen
        | image_url: width: 1200
        | image_tag:
          class: 'equipo__img',
          widths: '600, 900, 1200',
          sizes: '50vw',
          alt: section.settings.imagen.alt
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'equipo__img equipo__img--placeholder' }}
    {%- endif -%}
  </div>

  <div class="equipo__contenido" style="background-color: {{ section.settings.fondo_color }};">
    {%- if section.settings.etiqueta != blank -%}
      <p class="equipo__etiqueta" style="
        color: {{ section.settings.etiqueta_color }};
        font-size: {{ section.settings.etiqueta_tamano }};
        font-family: {{ section.settings.etiqueta_fuente }};
      ">{{ section.settings.etiqueta }}</p>
    {%- endif -%}

    {%- if section.settings.titulo != blank -%}
      <h2 class="equipo__titulo" style="
        color: {{ section.settings.titulo_color }};
        font-size: {{ section.settings.titulo_tamano }};
        font-family: {{ section.settings.titulo_fuente }};
        font-weight: {{ section.settings.titulo_peso }};
      ">
        {%- assign partes = section.settings.titulo | split: section.settings.palabra_destacada -%}
        {%- if section.settings.palabra_destacada != blank and partes.size > 1 -%}
          {{ partes[0] }}<em style="color: {{ section.settings.color_destacado }}; font-style: italic;">{{ section.settings.palabra_destacada }}</em>{{ partes[1] }}
        {%- else -%}
          {{ section.settings.titulo }}
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.descripcion != blank -%}
      <p class="equipo__descripcion" style="
        color: {{ section.settings.descripcion_color }};
        font-size: {{ section.settings.descripcion_tamano }};
        font-family: {{ section.settings.descripcion_fuente }};
      ">{{ section.settings.descripcion }}</p>
    {%- endif -%}

    {%- if section.settings.etiquetas != blank -%}
      <div class="equipo__tags">
        {%- assign tags = section.settings.etiquetas | split: ',' -%}
        {%- for tag in tags -%}
          <span class="equipo__tag" style="
            color: {{ section.settings.tag_color }};
            border-color: {{ section.settings.tag_borde_color }};
            font-size: {{ section.settings.tag_tamano }};
          ">{{ tag | strip }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="equipo__stats">
        {%- for block in section.blocks -%}
          <div class="equipo__stat" {{ block.shopify_attributes }}>
            {%- if block.settings.numero != blank -%}
              <p class="equipo__stat-numero" style="
                color: {{ block.settings.numero_color }};
                font-size: {{ block.settings.numero_tamano }};
                font-family: {{ block.settings.numero_fuente }};
                font-weight: {{ block.settings.numero_peso }};
              ">{{ block.settings.numero }}</p>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <p class="equipo__stat-label" style="
                color: {{ block.settings.label_color }};
                font-size: {{ block.settings.label_tamano }};
              ">{{ block.settings.label }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .equipo-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 500px;
  }

  @media screen and (min-width: 750px) {
    .equipo-wrapper {
      grid-template-columns: 1fr 1fr;
    }
  }

  .equipo__imagen {
    position: relative;
    overflow: hidden;
    min-height: 400px;
  }

  .equipo__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .equipo__img--placeholder svg {
    width: 100%;
    height: 100%;
    min-height: 400px;
  }

  .equipo__contenido {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    padding: 3rem 3.5rem;
  }

  @media screen and (max-width: 749px) {
    .equipo__contenido {
      padding: 2.5rem 1.5rem;
    }
  }

  .equipo__etiqueta {
    margin: 0;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .equipo__titulo {
    margin: 0;
    line-height: 1.15;
  }

  .equipo__descripcion {
    margin: 0;
    line-height: 1.7;
    max-width: 480px;
  }

  .equipo__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .equipo__tag {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border: 1px solid;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .equipo__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 0.5rem;
  }

  .equipo__stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .equipo__stat-numero {
    margin: 0;
    line-height: 1;
  }

  .equipo__stat-label {
    margin: 0;
    line-height: 1.4;
    max-width: 140px;
  }
{% endstylesheet %}

{% schema %}
