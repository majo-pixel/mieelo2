<div class="manif" style="background: {{ section.settings.fondo }}; padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 6vw, 6rem);">

  {%- if section.settings.etiqueta != blank -%}
    <p class="manif__etiqueta" style="color: {{ section.settings.etiqueta_color }};">
      {{ section.settings.etiqueta }}
    </p>
  {%- endif -%}

  {%- if section.settings.titulo_antes != blank or section.settings.titulo_destacado != blank or section.settings.titulo_despues != blank -%}
    <h2 class="manif__titulo" style="color: {{ section.settings.titulo_color }}; font-size: clamp(2.4rem, 6vw, {{ section.settings.titulo_tamano }}); font-family: {{ section.settings.titulo_fuente }}; font-weight: {{ section.settings.titulo_peso }};">
      {%- if section.settings.titulo_antes != blank -%}
        {{ section.settings.titulo_antes }}<br>
      {%- endif -%}
      {%- if section.settings.titulo_destacado != blank -%}
        <em style="color: {{ section.settings.destacado_color }}; font-style: italic;">{{ section.settings.titulo_destacado }}</em><br>
      {%- endif -%}
      {%- if section.settings.titulo_despues != blank -%}
        {{ section.settings.titulo_despues }}
      {%- endif -%}
    </h2>
  {%- endif -%}

  {%- if section.settings.descripcion != blank -%}
    <p class="manif__desc" style="color: {{ section.settings.desc_color }}; font-size: {{ section.settings.desc_tamano }};">
      {{ section.settings.descripcion }}
    </p>
  {%- endif -%}

  {%- if section.settings.boton_texto != blank -%}
    <a class="manif__boton" href="{{ section.settings.boton_link | default: '#' }}" style="color: {{ section.settings.boton_color }};">
      {{ section.settings.boton_texto }} &rarr;
    </a>
  {%- endif -%}

</div>

{% stylesheet %}
  .manif__etiqueta {
    margin: 0 0 1.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-family: sans-serif;
  }

  .manif__titulo {
    margin: 0 0 2rem;
    line-height: 1.15;
    max-width: 700px;
  }

  .manif__desc {
    margin: 0 0 2.5rem;
    line-height: 1.75;
    max-width: 580px;
  }

  .manif__boton {
    display: inline-block;
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: sans-serif;
    font-weight: 600;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition: opacity 0.2s;
  }

  .manif__boton:hover { opacity: 0.7; }
{% endstylesheet %}

{% schema %}
{
  "name": "Manifiesto",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "color",
      "id": "fondo",
      "label": "Color de fondo",
      "default": "#0D0D0D"
    },
    {
      "type": "header",
      "content": "Etiqueta"
    },
    {
      "type": "text",
      "id": "etiqueta",
      "label": "Texto etiqueta",
      "default": "OUR REASON FOR BEING"
    },
    {
      "type": "color",
      "id": "etiqueta_color",
      "label": "Color etiqueta",
      "default": "#888888"
    },
    {
      "type": "header",
      "content": "Titulo"
    },
    {
      "type": "text",
      "id": "titulo_antes",
      "label": "Texto antes de la palabra destacada",
      "default": "Not a charity. Not a project. A"
    },
    {
      "type": "text",
      "id": "titulo_destacado",
      "label": "Palabra destacada (en cursiva y color)",
      "default": "business"
    },
    {
      "type": "color",
      "id": "destacado_color",
      "label": "Color palabra destacada",
      "default": "#C97B5A"
    },
    {
      "type": "text",
      "id": "titulo_despues",
      "label": "Texto despues de la palabra destacada",
      "default": "built on craft."
    },
    {
      "type": "color",
      "id": "titulo_color",
      "label": "Color titulo",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "titulo_tamano",
      "label": "Tamano maximo titulo",
      "options": [
        { "value": "3rem", "label": "3rem" },
        { "value": "4rem", "label": "4rem" },
        { "value": "5rem", "label": "5rem" },
        { "value": "6rem", "label": "6rem" }
      ],
      "default": "5rem"
    },
    {
      "type": "select",
      "id": "titulo_fuente",
      "label": "Fuente titulo",
      "options": [
        { "value": "var(--font-heading--family)", "label": "Titulo del tema" },
        { "value": "var(--font-body--family)", "label": "Cuerpo del tema" },
        { "value": "serif", "label": "Serif" },
        { "value": "sans-serif", "label": "Sans-serif" }
      ],
      "default": "var(--font-heading--family)"
    },
    {
      "type": "select",
      "id": "titulo_peso",
      "label": "Peso fuente",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Descripcion"
    },
    {
      "type": "textarea",
      "id": "descripcion",
      "label": "Texto descripcion",
      "default": "mi eelo was born inside the community surrounding the largest landfill in Central America. We don't ask for sympathy - we build products. Real skill. Real pay. Real women deciding their own future."
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Color descripcion",
      "default": "#AAAAAA"
    },
    {
      "type": "select",
      "id": "desc_tamano",
      "label": "Tamano descripcion",
      "options": [
        { "value": "0.875rem", "label": "14px" },
        { "value": "1rem", "label": "16px" },
        { "value": "1.125rem", "label": "18px" }
      ],
      "default": "1rem"
    },
    {
      "type": "header",
      "content": "Boton"
    },
    {
      "type": "text",
      "id": "boton_texto",
      "label": "Texto boton",
      "default": "SEE OUR IMPACT"
    },
    {
      "type": "url",
      "id": "boton_link",
      "label": "Link boton"
    },
    {
      "type": "color",
      "id": "boton_color",
      "label": "Color boton",
      "default": "#C97B5A"
    }
  ],
  "presets": [
    {
      "name": "Manifiesto"
    }
  ]
}
{% endschema %}
