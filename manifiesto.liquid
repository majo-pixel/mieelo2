
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="manifiesto section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="manifiesto__grid">

    {%- comment -%} Columna izquierda {%- endcomment -%}
    <div class="manifiesto__left">

      {%- if section.settings.etiqueta != blank -%}
        <p class="manifiesto__etiqueta" style="color: {{ section.settings.etiqueta_color }}; font-size: {{ section.settings.etiqueta_tamano }}; font-family: {{ section.settings.etiqueta_fuente }};">{{ section.settings.etiqueta }}</p>
      {%- endif -%}

      {%- if section.settings.frase_principal != blank -%}
        <h2 class="manifiesto__frase rte" style="color: {{ section.settings.frase_color }}; font-size: {{ section.settings.frase_tamano }}; font-family: {{ section.settings.frase_fuente }}; font-weight: {{ section.settings.frase_peso }};">{{ section.settings.frase_principal }}</h2>
      {%- endif -%}

      {%- if section.settings.cita != blank -%}
        <div class="manifiesto__cita-wrap" style="border-left-color: {{ section.settings.cita_borde_color }}; border-left-width: {{ section.settings.cita_borde_grosor }}px;">
          <p class="manifiesto__cita" style="color: {{ section.settings.cita_color }}; font-size: {{ section.settings.cita_tamano }}; font-family: {{ section.settings.cita_fuente }}; font-style: italic;">{{ section.settings.cita }}</p>
        </div>
      {%- endif -%}

      {%- if section.settings.firma != blank -%}
        <div class="manifiesto__firma-wrap">
          {%- if section.settings.firma_decoracion -%}
            <div class="manifiesto__firma-linea" style="background: linear-gradient(to right, {{ section.settings.color_destacado }}, {{ section.settings.cita_borde_color }});"></div>
          {%- endif -%}
          <p class="manifiesto__firma" style="color: {{ section.settings.firma_color }}; font-size: {{ section.settings.firma_tamano }}; font-family: {{ section.settings.firma_fuente }}; letter-spacing: 0.1em;">{{ section.settings.firma }}</p>
        </div>
      {%- endif -%}

    </div>

    {%- comment -%} Columna derecha — pills/tags interactivas {%- endcomment -%}
    <div class="manifiesto__right">
      {%- for block in section.blocks -%}
        <button
          class="manifiesto__pill{% if block.settings.activo %} manifiesto__pill--activo{% endif %}"
          style="
            --pill-color-activo: {{ block.settings.color_activo }};
            --pill-texto-activo: {{ block.settings.texto_activo }};
            --pill-color-inactivo: {{ section.settings.pill_fondo_inactivo }};
            --pill-texto-inactivo: {{ section.settings.pill_color_inactivo }};
            --pill-borde: {{ section.settings.pill_borde_color }};
            font-size: {{ section.settings.pill_tamano }};
            font-family: {{ section.settings.pill_fuente }};
            border-radius: {{ section.settings.pill_radio }}px;
          "
          {{ block.shopify_attributes }}
        >
          {{ block.settings.texto }}
        </button>
      {%- endfor -%}
    </div>

  </div>
</div>


{% stylesheet %}
  .manifiesto__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .manifiesto__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 5rem;
    }
  }

  .manifiesto__left {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .manifiesto__etiqueta {
    margin: 0;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .manifiesto__frase {
    margin: 0;
    line-height: 1.2;
  }

  .manifiesto__frase p { margin: 0; }

  .manifiesto__cita-wrap {
    border-left: 3px solid;
    padding-left: 1.25rem;
  }

  .manifiesto__cita {
    margin: 0;
    line-height: 1.7;
  }

  .manifiesto__firma-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 0.5rem;
  }

  .manifiesto__firma-linea {
    height: 2px;
    width: 60px;
    border-radius: 2px;
  }

  .manifiesto__firma {
    margin: 0;
    text-transform: uppercase;
  }

  /* Pills lado derecho */
  .manifiesto__right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }

  @media screen and (min-width: 750px) {
    .manifiesto__right {
      align-items: flex-end;
    }
  }

  .manifiesto__pill {
    cursor: default;
    padding: 0.65rem 1.5rem;
    border: 1px solid var(--pill-borde);
    background-color: var(--pill-color-inactivo);
    color: var(--pill-texto-inactivo);
    border-radius: var(--pill-radio, 50px);
    transition: background-color 0.25s, color 0.25s, border-color 0.25s;
    white-space: nowrap;
  }

  .manifiesto__pill:hover {
    background-color: var(--pill-color-activo);
    color: var(--pill-texto-activo);
    border-color: var(--pill-color-activo);
  }

  .manifiesto__pill--activo {
    background-color: var(--pill-color-activo);
    color: var(--pill-texto-activo);
    border-color: var(--pill-color-activo);
  }
{% endstylesheet %}

