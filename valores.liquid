
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="valores section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="valores__grid">

    {%- comment -%} Columna izquierda {%- endcomment -%}
    <div class="valores__left">
      {%- if section.settings.etiqueta != blank -%}
        <p class="valores__etiqueta" style="
          font-size: {{ section.settings.etiqueta_tamano }};
          color: {{ section.settings.etiqueta_color }};
          font-weight: {{ section.settings.etiqueta_peso }};
          font-family: {{ section.settings.etiqueta_fuente }};
        ">{{ section.settings.etiqueta }}</p>
      {%- endif -%}

      {%- if section.settings.titulo != blank -%}
        <h2 class="valores__titulo" style="
          font-size: {{ section.settings.titulo_tamano }};
          color: {{ section.settings.titulo_color }};
          font-weight: {{ section.settings.titulo_peso }};
          font-family: {{ section.settings.titulo_fuente }};
        ">
          {%- assign partes = section.settings.titulo | split: section.settings.palabra_destacada -%}
          {%- if section.settings.palabra_destacada != blank and partes.size > 1 -%}
            {{ partes[0] }}<span style="color: {{ section.settings.color_destacado }}; font-style: italic;">{{ section.settings.palabra_destacada }}</span>{{ partes[1] }}
          {%- else -%}
            {{ section.settings.titulo }}
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.descripcion != blank -%}
        <p class="valores__descripcion" style="
          font-size: {{ section.settings.descripcion_tamano }};
          color: {{ section.settings.descripcion_color }};
          font-weight: {{ section.settings.descripcion_peso }};
          font-family: {{ section.settings.descripcion_fuente }};
        ">{{ section.settings.descripcion }}</p>
      {%- endif -%}

      {%- if section.settings.boton_texto != blank and section.settings.boton_link != blank -%}
        <a
          href="{{ section.settings.boton_link }}"
          class="valores__boton button-secondary"
          {% if section.settings.boton_nueva_pestana %}target="_blank" rel="noopener"{% endif %}
        >
          {{ section.settings.boton_texto }}
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Columna derecha {%- endcomment -%}
    <div class="valores__right">
      {%- for block in section.blocks -%}
        <div class="valores__item" {{ block.shopify_attributes }}>
          <div class="valores__item-top">
            {%- if block.settings.numero != blank or block.settings.categoria != blank -%}
              <p class="valores__item-meta" style="
                color: {{ block.settings.meta_color }};
                font-size: {{ block.settings.meta_tamano }};
                font-weight: {{ block.settings.meta_peso }};
                font-family: {{ block.settings.meta_fuente }};
              ">
                {%- if block.settings.numero != blank -%}{{ block.settings.numero }}{%- endif -%}
                {%- if block.settings.numero != blank and block.settings.categoria != blank -%} — {%- endif -%}
                {%- if block.settings.categoria != blank -%}{{ block.settings.categoria }}{%- endif -%}
              </p>
            {%- endif -%}
            {%- if block.settings.titulo != blank -%}
              <h3 class="valores__item-titulo" style="
                font-size: {{ block.settings.titulo_tamano }};
                color: {{ block.settings.titulo_color }};
                font-weight: {{ block.settings.titulo_peso }};
                font-family: {{ block.settings.titulo_fuente }};
              ">{{ block.settings.titulo }}</h3>
            {%- endif -%}
            {%- if block.settings.descripcion != blank -%}
              <p class="valores__item-descripcion" style="
                font-size: {{ block.settings.desc_tamano }};
                color: {{ block.settings.desc_color }};
                font-weight: {{ block.settings.desc_peso }};
                font-family: {{ block.settings.desc_fuente }};
              ">{{ block.settings.descripcion }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .valores__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media screen and (min-width: 750px) {
    .valores__grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .valores__left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .valores__etiqueta {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
  }

  .valores__titulo {
    line-height: 1.1;
    margin: 0;
  }

  .valores__descripcion {
    line-height: 1.7;
    margin: 0;
    max-width: 480px;
  }

  .valores__boton {
    display: inline-block;
    align-self: flex-start;
  }

  .valores__right {
    display: flex;
    flex-direction: column;
  }

  .valores__item {
    padding-block: 1.75rem;
    border-top: 1px solid currentColor;
    opacity: 0.9;
  }

  .valores__item:last-child {
    border-bottom: 1px solid currentColor;
  }

  .valores__item-top {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .valores__item-meta {
    margin: 0;
    font-style: italic;
    letter-spacing: 0.05em;
  }

  .valores__item-titulo {
    margin: 0;
  }

  .valores__item-descripcion {
    line-height: 1.6;
    margin: 0.25rem 0 0;
  }
{% endstylesheet %}

