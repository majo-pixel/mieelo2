      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "The Makers",
      "blocks": [
        { "type": "persona", "settings": { "nombre": "Ana Lucía", "rol": "SEAMSTRESS · 3 YEARS", "cita": "Every bag I make, I think about who will carry it." } },
        { "type": "persona", "settings": { "nombre": "Carmen Rosa", "rol": "SCREEN PRINTER · 2 YEARS", "cita": "The ink dries, and the design is mine. That pride doesn't wash off." } },
