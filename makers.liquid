
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="makers section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>

  {%- comment -%} Encabezado {%- endcomment -%}
  <div class="makers__header">
    <div class="makers__header-left">
      {%- if section.settings.etiqueta != blank -%}
        <p class="makers__etiqueta" style="
          color: {{ section.settings.etiqueta_color }};
          font-size: {{ section.settings.etiqueta_tamano }};
          font-family: {{ section.settings.etiqueta_fuente }};
        ">{{ section.settings.etiqueta }}</p>
      {%- endif -%}

      {%- if section.settings.titulo != blank -%}
        <h2 class="makers__titulo rte" style="
          color: {{ section.settings.titulo_color }};
          font-size: {{ section.settings.titulo_tamano }};
          font-family: {{ section.settings.titulo_fuente }};
          font-weight: {{ section.settings.titulo_peso }};
        ">{{ section.settings.titulo }}</h2>
      {%- endif -%}
    </div>

    {%- if section.settings.boton_texto != blank and section.settings.boton_link != blank -%}
      <div class="makers__header-right">
        <a
          href="{{ section.settings.boton_link }}"
          class="makers__boton button-secondary"
          {% if section.settings.boton_nueva_pestana %}target="_blank" rel="noopener"{% endif %}
          style="color: {{ section.settings.boton_color }}; border-color: {{ section.settings.boton_borde }};"
        >
          {{ section.settings.boton_texto }} →
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Grid de personas {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="makers__grid" style="--cols: {{ section.settings.columnas }};">
      {%- for block in section.blocks -%}
        <div class="makers__card" {{ block.shopify_attributes }}>
          <div class="makers__foto-wrapper">
            {%- if block.settings.foto != blank -%}
              {{
                block.settings.foto
                | image_url: width: 600
                | image_tag:
                  class: 'makers__foto',
                  widths: '300, 400, 600',
                  sizes: '(min-width: 750px) 20vw, 50vw',
                  alt: block.settings.nombre
              }}
            {%- else -%}
              <div class="makers__foto-placeholder">
                <svg viewBox="0 0 300 400" xmlns="http://www.w3.org/2000/svg" fill="currentColor" opacity="0.2">
                  <rect width="300" height="400" fill="#cccccc"/>
                  <circle cx="150" cy="140" r="60"/>
                  <ellipse cx="150" cy="340" rx="100" ry="80"/>
                </svg>
              </div>
            {%- endif -%}
          </div>

          <div class="makers__info">
            {%- if block.settings.nombre != blank -%}
              <p class="makers__nombre" style="
                color: {{ block.settings.nombre_color }};
                font-size: {{ block.settings.nombre_tamano }};
                font-family: {{ block.settings.nombre_fuente }};
              ">{{ block.settings.nombre }}</p>
            {%- endif -%}

            {%- if block.settings.rol != blank -%}
              <p class="makers__rol" style="
                color: {{ block.settings.rol_color }};
                font-size: {{ block.settings.rol_tamano }};
              ">{{ block.settings.rol }}</p>
            {%- endif -%}

            {%- if block.settings.cita != blank -%}
              <p class="makers__cita" style="
                color: {{ block.settings.cita_color }};
                font-size: {{ block.settings.cita_tamano }};
                font-style: italic;
              ">"{{ block.settings.cita }}"</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>

{% stylesheet %}
  .makers__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
    gap: 1rem;
  }

  .makers__header-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .makers__etiqueta {
    margin: 0;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .makers__titulo {
    margin: 0;
    line-height: 1.15;
  }

  .makers__boton {
    display: inline-block;
    white-space: nowrap;
    padding: 0.6rem 1.2rem;
    border: 1px solid;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .makers__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .makers__grid {
      grid-template-columns: repeat(var(--cols, 5), 1fr);
    }
  }

  .makers__card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .makers__foto-wrapper {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 4px;
  }

  .makers__foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .makers__card:hover .makers__foto {
    transform: scale(1.03);
  }

  .makers__foto-placeholder {
    width: 100%;
    height: 100%;
    background-color: #e8e0d8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .makers__foto-placeholder svg {
    width: 60%;
    height: 60%;
  }

  .makers__info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .makers__nombre {
    margin: 0;
    line-height: 1.2;
  }

  .makers__rol {
    margin: 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .makers__cita {
    margin: 0.25rem 0 0;
    line-height: 1.5;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "The Makers",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "persona",
      "name": "Persona",
      "settings": [
        {
          "type": "image_picker",
          "id": "foto",
          "label": "Foto"
        },
        {
          "type": "text",
          "id": "nombre",
          "label": "Nombre",
          "default": "Ana Lucía"
        },
        {
          "type": "color",
          "id": "nombre_color",
          "label": "Color nombre",
          "default": "#3A3A3A"
        },
        {
          "type": "select",
          "id": "nombre_tamano",
          "label": "Tamaño nombre",
          "options": [
            { "value": "0.875rem", "label": "14px" },
            { "value": "1rem", "label": "16px" },
            { "value": "1.125rem", "label": "18px" }
          ],
          "default": "1rem"
        },
        {
          "type": "select",
          "id": "nombre_fuente",
          "label": "Fuente nombre",
          "options": [
            { "value": "var(--font-body--family)", "label": "Cuerpo" },
            { "value": "var(--font-heading--family)", "label": "Título" },
            { "value": "var(--font-accent--family)", "label": "Acento" }
          ],
          "default": "var(--font-heading--family)"
        },
        {
          "type": "text",
          "id": "rol",
          "label": "Rol · Años",
          "default": "Seamstress · 3 Years",
          "info": "Ej: SEAMSTRESS · 3 YEARS"
        },
        {
          "type": "color",
          "id": "rol_color",
          "label": "Color rol",
          "default": "#999999"
        },
        {
          "type": "select",
          "id": "rol_tamano",
          "label": "Tamaño rol",
          "options": [
            { "value": "0.625rem", "label": "10px" },
            { "value": "0.75rem", "label": "12px" },
            { "value": "0.875rem", "label": "14px" }
          ],
          "default": "0.75rem"
        },
        {
          "type": "textarea",
          "id": "cita",
          "label": "Cita / Frase",
          "default": "Every bag I make, I think about who will carry it."
        },
        {
          "type": "color",
          "id": "cita_color",
          "label": "Color cita",
          "default": "#777777"
        },
        {
          "type": "select",
          "id": "cita_tamano",
          "label": "Tamaño cita",
          "options": [
            { "value": "0.75rem", "label": "12px" },
            { "value": "0.875rem", "label": "14px" },
            { "value": "1rem", "label": "16px" }
          ],
          "default": "0.875rem"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "etiqueta",
      "label": "Etiqueta superior",
      "default": "THE MAKERS"
    },
    {
      "type": "color",
      "id": "etiqueta_color",
      "label": "Color etiqueta",
      "default": "#999999"
    },
    {
      "type": "select",
      "id": "etiqueta_tamano",
      "label": "Tamaño etiqueta",
      "options": [
        { "value": "0.625rem", "label": "10px" },
        { "value": "0.75rem", "label": "12px" },
        { "value": "0.875rem", "label": "14px" }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "etiqueta_fuente",
      "label": "Fuente etiqueta",
      "options": [
        { "value": "var(--font-body--family)", "label": "Cuerpo" },
