    {
      "type": "range",
      "id": "card_padding",
      "label": "Espaciado interno info",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "mostrar_linea",
      "label": "Mostrar línea entre rol y cita",
      "default": true
    },
    {
      "type": "color",
      "id": "linea_color",
      "label": "Color de la línea",
      "default": "#CCCCCC"
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        { "value": "page-width", "label": "Página" },
        { "value": "full-width", "label": "Completo" }
      ],
