
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="makers section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>

  {%- comment -%} Encabezado {%- endcomment -%}
  <div class="makers__header">
    <div class="makers__header-left">
      {%- if section.settings.etiqueta != blank -%}
        <p class="makers__etiqueta" style="color:{{ section.settings.etiqueta_color }};font-size:{{ section.settings.etiqueta_tamano }};font-family:{{ section.settings.etiqueta_fuente }};">{{ section.settings.etiqueta }}</p>
      {%- endif -%}
      {%- if section.settings.titulo != blank -%}
        <h2 class="makers__titulo rte" style="color:{{ section.settings.titulo_color }};font-size:{{ section.settings.titulo_tamano }};font-family:{{ section.settings.titulo_fuente }};font-weight:{{ section.settings.titulo_peso }};">{{ section.settings.titulo }}</h2>
      {%- endif -%}
    </div>
    <div class="makers__header-right">
      {%- if section.settings.boton_texto != blank -%}
        <a href="{{ section.settings.boton_link | default: '#' }}" class="makers__boton" {% if section.settings.boton_nueva_pestana %}target="_blank" rel="noopener"{% endif %} style="color:{{ section.settings.boton_color }};border-color:{{ section.settings.boton_borde }};">{{ section.settings.boton_texto }} →</a>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="makers__nav">
          <button class="makers__nav-btn" id="makers-prev-{{ section.id }}" aria-label="Anterior">&#8592;</button>
          <button class="makers__nav-btn" id="makers-next-{{ section.id }}" aria-label="Siguiente">&#8594;</button>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Carousel {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="makers__carousel" id="makers-carousel-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="makers__card" style="background-color:{{ block.settings.card_fondo }};border-radius:{{ section.settings.card_radio }}px;" {{ block.shopify_attributes }}>
          <div class="makers__foto-wrapper">
            {%- if block.settings.foto != blank -%}
              {{ block.settings.foto | image_url: width: 600 | image_tag: class: 'makers__foto', widths: '300, 400, 600', sizes: '(min-width: 750px) 20vw, 50vw', alt: block.settings.nombre }}
            {%- else -%}
              <div class="makers__foto-placeholder">
                <svg viewBox="0 0 300 400" xmlns="http://www.w3.org/2000/svg">
                  <rect width="300" height="400" fill="#d8cfc8"/>
                  <circle cx="150" cy="140" r="60" fill="#b8afa8"/>
                  <ellipse cx="150" cy="340" rx="100" ry="80" fill="#b8afa8"/>
                </svg>
              </div>
            {%- endif -%}
          </div>
          <div class="makers__info" style="padding:{{ section.settings.card_padding }}px;">
            {%- if block.settings.nombre != blank -%}
              <p class="makers__nombre" style="color:{{ block.settings.nombre_color }};font-size:{{ block.settings.nombre_tamano }};font-family:{{ block.settings.nombre_fuente }};">{{ block.settings.nombre }}</p>
            {%- endif -%}
            {%- if block.settings.rol != blank -%}
              <p class="makers__rol" style="color:{{ block.settings.rol_color }};font-size:{{ block.settings.rol_tamano }};">{{ block.settings.rol }}</p>
            {%- endif -%}
            {%- if section.settings.mostrar_linea -%}
              <hr class="makers__linea" style="border-color:{{ section.settings.linea_color }};">
            {%- endif -%}
            {%- if block.settings.cita != blank -%}
              <p class="makers__cita" style="color:{{ block.settings.cita_color }};font-size:{{ block.settings.cita_tamano }};">"{{ block.settings.cita }}"</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>

<script>
  (function() {
    var carousel = document.getElementById('makers-carousel-{{ section.id }}');
    var btnPrev = document.getElementById('makers-prev-{{ section.id }}');
    var btnNext = document.getElementById('makers-next-{{ section.id }}');
    if (!carousel || !btnPrev || !btnNext) return;

    function getScrollAmount() {
      var card = carousel.querySelector('.makers__card');
      return card ? card.offsetWidth + 24 : 300;
    }

    btnNext.addEventListener('click', function() {
      carousel.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });
    btnPrev.addEventListener('click', function() {
      carousel.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });
  })();
</script>

{% stylesheet %}
  .makers__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .makers__header-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .makers__header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .makers__etiqueta {
    margin: 0;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .makers__titulo {
    margin: 0;
    line-height: 1.15;
  }

  .makers__titulo p { margin: 0; }

  .makers__boton {
    display: inline-block;
    white-space: nowrap;
    padding: 0.6rem 1.2rem;
    border: 1px solid;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .makers__nav {
    display: flex;
    gap: 0.5rem;
  }

  .makers__nav-btn {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid currentColor;
    background: transparent;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    transition: background 0.2s, color 0.2s;
  }

  .makers__nav-btn:hover {
    background: currentColor;
  }

  .makers__nav-btn:hover span,
  .makers__nav-btn:hover {
    color: var(--color-background);
  }

  /* Carousel */
  .makers__carousel {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
  }

  .makers__carousel::-webkit-scrollbar {
    display: none;
  }

  .makers__card {
    scroll-snap-align: start;
    flex: 0 0 calc((100% - 3rem) / 2);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .makers__card {
      flex: 0 0 calc((100% - 6rem) / 4);
    }
  }

  @media screen and (min-width: 1100px) {
    .makers__card {
      flex: 0 0 calc((100% - 7.5rem) / 5);
    }
  }

  .makers__foto-wrapper {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .makers__foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .makers__card:hover .makers__foto {
    transform: scale(1.03);
  }

  .makers__foto-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #e0d8d0;
  }

  .makers__foto-placeholder svg {
    width: 100%;
    height: 100%;
  }

  .makers__info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }

  .makers__nombre {
    margin: 0;
    line-height: 1.2;
  }

  .makers__rol {
    margin: 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .makers__linea {
    border: none;
    border-top: 1px solid;
    margin: 0.5rem 0;
    opacity: 0.4;
  }

  .makers__cita {
    margin: 0;
    font-style: italic;
    line-height: 1.5;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "The Makers",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [
    {
      "type": "persona",
      "name": "Persona",
      "settings": [
        {
          "type": "image_picker",
          "id": "foto",
          "label": "Foto"
        },
        {
          "type": "color",
          "id": "card_fondo",
          "label": "Color de fondo de tarjeta",
          "default": "#F5EFE9"
        },
        {
          "type": "text",
          "id": "nombre",
          "label": "Nombre",
          "default": "Ana Lucía"
        },
        {
          "type": "color",
          "id": "nombre_color",
          "label": "Color nombre",
          "default": "#3A3A3A"
        },
        {
          "type": "select",
          "id": "nombre_tamano",
          "label": "Tamaño nombre",
          "options": [
            { "value": "0.875rem", "label": "14px" },
            { "value": "1rem", "label": "16px" },
            { "value": "1.125rem", "label": "18px" }
          ],
          "default": "1rem"
        },
        {
          "type": "select",
          "id": "nombre_fuente",
          "label": "Fuente nombre",
          "options": [
            { "value": "var(--font-body--family)", "label": "Cuerpo" },
            { "value": "var(--font-heading--family)", "label": "Título" },
            { "value": "var(--font-accent--family)", "label": "Acento" }
          ],
          "default": "var(--font-heading--family)"
        },
        {
          "type": "text",
          "id": "rol",
          "label": "Rol · Años",
          "default": "SEAMSTRESS · 3 YEARS"
        },
        {
          "type": "color",
          "id": "rol_color",
          "label": "Color rol",
          "default": "#999999"
        },
        {
          "type": "select",
          "id": "rol_tamano",
          "label": "Tamaño rol",
          "options": [
            { "value": "0.625rem", "label": "10px" },
            { "value": "0.75rem", "label": "12px" },
            { "value": "0.875rem", "label": "14px" }
          ],
          "default": "0.75rem"
        },
        {
          "type": "textarea",
          "id": "cita",
          "label": "Cita / Frase",
          "default": "Every bag I make, I think about who will carry it."
        },
        {
          "type": "color",
          "id": "cita_color",
          "label": "Color cita",
          "default": "#777777"
        },
        {
          "type": "select",
          "id": "cita_tamano",
          "label": "Tamaño cita",
          "options": [
            { "value": "0.75rem", "label": "12px" },
            { "value": "0.875rem", "label": "14px" },
            { "value": "1rem", "label": "16px" }
          ],
          "default": "0.875rem"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "etiqueta",
      "label": "Etiqueta superior",
      "default": "THE MAKERS"
    },
    {
      "type": "color",
      "id": "etiqueta_color",
      "label": "Color etiqueta",
      "default": "#999999"
    },
    {
      "type": "select",
      "id": "etiqueta_tamano",
      "label": "Tamaño etiqueta",
      "options": [
        { "value": "0.625rem", "label": "10px" },
        { "value": "0.75rem", "label": "12px" },
        { "value": "0.875rem", "label": "14px" }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "etiqueta_fuente",
      "label": "Fuente etiqueta",
