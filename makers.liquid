        { "value": "var(--font-heading--family)", "label": "Título" },
        { "value": "var(--font-accent--family)", "label": "Acento" }
      ],
      "default": "var(--font-body--family)"
    },
    {
      "type": "richtext",
      "id": "titulo",
      "label": "Título",
      "default": "<p>The names behind the <em>stitches.</em></p>",
      "info": "Usa negrilla, cursiva y colores desde la barra de herramientas"
    },
    {
      "type": "color",
      "id": "titulo_color",
      "label": "Color título",
      "default": "#2C2C2C"
    },
    {
      "type": "select",
      "id": "titulo_tamano",
      "label": "Tamaño título",
      "options": [
        { "value": "1.5rem", "label": "24px" },
        { "value": "2rem", "label": "32px" },
        { "value": "2.5rem", "label": "40px" },
