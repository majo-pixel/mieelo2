
<div
  class="estadistica-block color-{{ block.settings.color_scheme }}"
  style="
    background-color: {{ block.settings.fondo }};
    border: {{ block.settings.borde_grosor }}px solid {{ block.settings.borde_color }};
    border-radius: {{ block.settings.radio }}px;
    padding: {{ block.settings.padding }}px;
    text-align: {{ block.settings.alineacion }};
    min-width: {{ block.settings.ancho_minimo }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.numero != blank -%}
    <p class="estadistica-block__numero" style="color: {{ block.settings.color_numero }}; font-size: {{ block.settings.tamano_numero }}px; font-weight: {{ block.settings.peso_fuente }}; margin: 0; line-height: 1.1;">
      {{ block.settings.numero }}
    </p>
  {%- endif -%}

  {%- if block.settings.etiqueta != blank -%}
    <p class="estadistica-block__etiqueta" style="color: {{ block.settings.color_etiqueta }}; font-size: {{ block.settings.tamano_etiqueta }}px; margin: 4px 0 0; letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.3;">
      {{ block.settings.etiqueta }}
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .estadistica-block {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Estadística",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "numero",
      "label": "Número / Dato principal",
      "default": "30+"
    },
    {
      "type": "text",
      "id": "etiqueta",
      "label": "Etiqueta descriptiva",
      "default": "WOMEN EMPLOYED"
    },
    {
      "type": "header",
      "content": "Estilo del número"
    },
    {
      "type": "color",
      "id": "color_numero",
      "label": "Color del número",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "tamano_numero",
      "label": "Tamaño del número",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "peso_fuente",
      "label": "Grosor del número",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "600", "label": "Semi-negrita" },
        { "value": "700", "label": "Negrita" },
        { "value": "800", "label": "Extra negrita" }
      ],
      "default": "700"
    },
    {
      "type": "header",
      "content": "Estilo de la etiqueta"
    },
    {
      "type": "color",
      "id": "color_etiqueta",
      "label": "Color de la etiqueta",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "tamano_etiqueta",
      "label": "Tamaño de la etiqueta",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "header",
      "content": "Caja / Fondo"
    },
    {
      "type": "color",
      "id": "fondo",
      "label": "Color de fondo",
      "default": "#00000000"
    },
    {
      "type": "color",
      "id": "borde_color",
      "label": "Color del borde",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "borde_grosor",
      "label": "Grosor del borde",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "radio",
      "label": "Bordes redondeados",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Espaciado interno",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "ancho_minimo",
      "label": "Ancho mínimo",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "select",
      "id": "alineacion",
      "label": "Alineación",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Estadística",
      "category": "Contenido",
      "settings": {
        "numero": "30+",
        "etiqueta": "WOMEN EMPLOYED"
      }
    }
  ]
}
{% endschema %}
