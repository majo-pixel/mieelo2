<div class="mq-wrap" style="background:{{ section.settings.fondo }}; padding:{{ section.settings.padding_v }}px 0; overflow:hidden; width:100%;">
  <div class="mq-inner" style="animation: mq-slide {{ section.settings.velocidad }}s linear infinite; white-space:nowrap; display:inline-block;">
    {%- assign items_html = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'item' -%}
        {%- capture item -%}
          <span style="display:inline-block; color:{{ block.settings.color }}; font-size:{{ section.settings.tamano }}; font-family:{{ section.settings.fuente }}; font-weight:{{ section.settings.peso }}; letter-spacing:{{ section.settings.espaciado }}em; text-transform:uppercase; padding:0 0.5rem;">{{ block.settings.texto }}</span><span style="display:inline-block; color:{{ section.settings.sep_color }}; padding:0 0.6rem; opacity:0.8;">{{ section.settings.separador }}</span>
        {%- endcapture -%}
        {%- assign items_html = items_html | append: item -%}
      {%- endif -%}
    {%- endfor -%}
    {{ items_html }}{{ items_html }}{{ items_html }}{{ items_html }}
  </div>
</div>

<style>
  @keyframes mq-slide {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mq-inner { animation: none !important; }
  }
</style>

{% schema %}
{
  "name": "Marquee Banner",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "fondo",
      "label": "Color de fondo",
      "default": "#E8957A"
    },
    {
      "type": "range",
      "id": "padding_v",
      "label": "Altura (padding vertical)",
      "min": 6,
      "max": 40,
      "step": 2,
      "default": 14
    },
    {
      "type": "range",
      "id": "velocidad",
      "label": "Velocidad (segundos por vuelta)",
      "min": 8,
      "max": 60,
      "step": 2,
      "default": 22
    },
    {
      "type": "text",
      "id": "separador",
      "label": "Separador entre palabras",
      "default": "•"
    },
    {
      "type": "color",
      "id": "sep_color",
      "label": "Color separador",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "tamano",
      "label": "Tamaño de texto",
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "fuente",
      "label": "Fuente",
      "options": [
        { "value": "sans-serif", "label": "Sans-serif" },
        { "value": "serif", "label": "Serif" },
        { "value": "inherit", "label": "Del tema" }
      ],
      "default": "sans-serif"
    },
    {
      "type": "select",
      "id": "peso",
      "label": "Peso de fuente",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" }
      ],
      "default": "700"
    },
    {
      "type": "text",
      "id": "espaciado",
      "label": "Espaciado entre letras (em)",
      "default": "0.12"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Texto",
      "settings": [
        {
          "type": "text",
          "id": "texto",
          "label": "Texto",
          "default": "Honest Materials"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color texto",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Banner",
      "blocks": [
        { "type": "item", "settings": { "texto": "Honest Materials" } },
        { "type": "item", "settings": { "texto": "Made in Guatemala" } },
        { "type": "item", "settings": { "texto": "1 Product = 1 Opportunity" } },
        { "type": "item", "settings": { "texto": "Co-Creation" } },
        { "type": "item", "settings": { "texto": "Skill, no Pity" } },
        { "type": "item", "settings": { "texto": "Noble Humans" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
