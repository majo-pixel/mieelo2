
<footer class="footer-custom" style="background-color: {{ section.settings.fondo_color }};">
  <div class="footer-custom__inner section section--page-width">

    {%- comment -%} Columna Logo {%- endcomment -%}
    <div class="footer-custom__col footer-custom__col--brand">
      {%- if section.settings.logo_texto != blank -%}
        <a href="/" class="footer-custom__logo" style="font-family: {{ section.settings.logo_fuente }}; font-size: {{ section.settings.logo_tamano }};">
          <span style="color: {{ section.settings.logo_color_1 }};">{{ section.settings.logo_parte_1 }}</span>
          <em style="color: {{ section.settings.logo_color_2 }};">{{ section.settings.logo_parte_2 }}</em>
        </a>
      {%- endif -%}

      {%- if section.settings.descripcion != blank -%}
        <p class="footer-custom__desc" style="color: {{ section.settings.desc_color }}; font-size: {{ section.settings.desc_tamano }};">{{ section.settings.descripcion }}</p>
      {%- endif -%}

      <div class="footer-custom__socials">
        {%- if section.settings.instagram_url != blank -%}
          <a href="{{ section.settings.instagram_url }}" class="footer-custom__social" style="color: {{ section.settings.social_color }}; font-size: {{ section.settings.social_tamano }};" target="_blank" rel="noopener">INSTAGRAM</a>
        {%- endif -%}
        {%- if section.settings.facebook_url != blank -%}
          <a href="{{ section.settings.facebook_url }}" class="footer-custom__social" style="color: {{ section.settings.social_color }}; font-size: {{ section.settings.social_tamano }};" target="_blank" rel="noopener">FACEBOOK</a>
        {%- endif -%}
        {%- if section.settings.youtube_url != blank -%}
          <a href="{{ section.settings.youtube_url }}" class="footer-custom__social" style="color: {{ section.settings.social_color }}; font-size: {{ section.settings.social_tamano }};" target="_blank" rel="noopener">YOUTUBE</a>
        {%- endif -%}
        {%- if section.settings.tiktok_url != blank -%}
          <a href="{{ section.settings.tiktok_url }}" class="footer-custom__social" style="color: {{ section.settings.social_color }}; font-size: {{ section.settings.social_tamano }};" target="_blank" rel="noopener">TIKTOK</a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Columnas de links desde bloques {%- endcomment -%}
    {%- for block in section.blocks -%}
      <div class="footer-custom__col" {{ block.shopify_attributes }}>
        {%- if block.settings.titulo_col != blank -%}
          <p class="footer-custom__col-titulo" style="color: {{ block.settings.titulo_color }}; font-size: {{ block.settings.titulo_tamano }}; font-family: {{ block.settings.titulo_fuente }};">{{ block.settings.titulo_col }}</p>
        {%- endif -%}
        <ul class="footer-custom__links">
          {%- for i in (1..6) -%}
            {%- assign label_key = 'link_' | append: i | append: '_label' -%}
            {%- assign url_key = 'link_' | append: i | append: '_url' -%}
            {%- assign label = block.settings[label_key] -%}
            {%- assign url = block.settings[url_key] -%}
            {%- if label != blank -%}
              <li>
                <a href="{{ url | default: '#' }}" class="footer-custom__link" style="color: {{ block.settings.link_color }}; font-size: {{ block.settings.link_tamano }};">{{ label }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}

  </div>

  {%- comment -%} Línea divisora {%- endcomment -%}
  <div class="footer-custom__divider" style="border-color: {{ section.settings.linea_color }};"></div>

  {%- comment -%} Barra inferior {%- endcomment -%}
  <div class="footer-custom__bottom section section--page-width">
    <p class="footer-custom__copy" style="color: {{ section.settings.copy_color }}; font-size: {{ section.settings.copy_tamano }};">{{ section.settings.copyright }}</p>
    {%- if section.settings.bottom_texto != blank -%}
      <p class="footer-custom__bottom-texto" style="color: {{ section.settings.copy_color }}; font-size: {{ section.settings.copy_tamano }};">
        {{ section.settings.bottom_texto_pre }}
        {%- if section.settings.bottom_link_url != blank -%}
          <a href="{{ section.settings.bottom_link_url }}" style="color: {{ section.settings.bottom_link_color }};" target="_blank" rel="noopener">{{ section.settings.bottom_link_label }}</a>
        {%- endif -%}
        {{ section.settings.bottom_texto_post }}
      </p>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .footer-custom {
    width: 100%;
    padding-top: 4rem;
  }

  .footer-custom__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  @media screen and (min-width: 750px) {
    .footer-custom__inner {
      grid-template-columns: 1.5fr repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .footer-custom__col {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .footer-custom__logo {
    display: inline-flex;
    gap: 0.3rem;
    text-decoration: none;
    line-height: 1;
  }

  .footer-custom__logo em {
    font-style: italic;
  }

  .footer-custom__desc {
    margin: 0;
    line-height: 1.6;
  }

  .footer-custom__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-custom__social {
    text-decoration: none;
    letter-spacing: 0.08em;
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .footer-custom__social:hover {
    opacity: 1;
  }

  .footer-custom__col-titulo {
    margin: 0;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-custom__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-custom__link {
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.2s;
    line-height: 1.4;
  }

  .footer-custom__link:hover {
    opacity: 1;
  }

  .footer-custom__divider {
    border: none;
    border-top: 1px solid;
    opacity: 0.2;
    margin: 0 auto;
    width: calc(100% - 4rem);
  }

  .footer-custom__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }

  .footer-custom__copy,
  .footer-custom__bottom-texto {
    margin: 0;
    opacity: 0.6;
  }

  .footer-custom__bottom-texto a {
    opacity: 1;
  }
{% endstylesheet %}

